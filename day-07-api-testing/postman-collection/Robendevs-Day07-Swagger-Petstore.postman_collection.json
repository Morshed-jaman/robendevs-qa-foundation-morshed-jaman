      "item": [
        {
          "name": "POS-01 - Find Available Pets",
          "request": {
            "method": "GET",
            "url": {
              "protocol": "https",
              "path": [
                "v2",
                "pet",
                "findByStatus"
              ],
              "host": [
                "petstore",
                "swagger",
                "io"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "available"
                }
              ],
              "variable": []
            },
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is a JSON array\", function () {\r",
                  "    const pets = pm.response.json();\r",
                  "    pm.expect(pets).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"All returned pets are available\", function () {\r",
                  "    const pets = pm.response.json();\r",
                  "\r",
                  "    pets.forEach(function (pet) {\r",
                  "        pm.expect(pet.status).to.eql(\"available\");\r",
                  "    });\r",
                  "});\r",
                  ""
                ]
              }
            }
          ]
        },
