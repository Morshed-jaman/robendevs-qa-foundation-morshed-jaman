                "host": [
                  "{{baseUrl}}"
                ],
                "query": [],
                "variable": []
              },
              "method": "PUT",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"id\": {{day08PetId}},\n  \"name\": \"Day 08 Assessment Pet\",\n  \"photoUrls\": [],\n  \"status\": \"sold\"\n}",
                "options": {
                  "raw": {
                    "language": "json"
                  }
                }
              }
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "3c8658a9-c6e6-41ad-b5b4-3b7cc019d6bd",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test(\"PUT returns 200\", () => pm.response.to.have.status(200));",
                    "pm.test(\"ID and status match request\", () => {",
                    "  const pet=pm.response.json();",
                    "  pm.expect(pet.id).to.eql(Number(pm.collectionVariables.get(\"day08PetId\")));",
                    "  pm.expect(pet.status).to.eql(\"sold\");",
                    "});"
                  ]
                }
              }
            ]
          },
          {
            "id": "885027af-3005-49da-b9c8-ab491faec976",
            "name": "IDEM-02 - Verify Final Pet State",
            "request": {
              "url": {
                "path": [
