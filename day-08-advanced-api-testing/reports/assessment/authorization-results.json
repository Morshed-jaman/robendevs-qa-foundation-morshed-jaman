{
  "collection": {
    "item": [
      {
        "id": "7b807bf2-b027-4499-80f7-e424bde23f11",
        "name": "05 - Request Chaining",
        "item": [
          {
            "id": "a903394e-8d79-41de-a3ff-03a635bc8364",
            "name": "CHAIN-01 - Create Pet and Save ID",
            "request": {
              "url": {
                "path": [
                  "pet"
                ],
                "host": [
                  "{{baseUrl}}"
                ],
                "query": [],
                "variable": []
              },
              "method": "POST",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"id\": {{day08PetId}},\n  \"name\": \"Day 08 Assessment Pet\",\n  \"photoUrls\": [],\n  \"status\": \"available\"\n}",
                "options": {
                  "raw": {
                    "language": "json"
                  }
                }
              }
            },
            "response": [],
            "event": [
              {
                "listen": "prerequest",
                "script": {
                  "id": "33a217d0-74e9-45f8-afc6-60a5a26665f6",
                  "type": "text/javascript",
                  "exec": [
                    "// A fresh temporary ID per run; shared by the chained requests.",
                    "pm.collectionVariables.set('day08PetId', String(Date.now()));"
                  ]
                }
              },
              {
                "listen": "test",
                "script": {
                  "id": "e0a108f5-a7b4-4345-af9d-e3aebdbe1368",
                  "type": "text/javascript",
                  "exec": [
                    "const pet = pm.response.json();",
                    "pm.test(\"Create returns 200\", () => pm.response.to.have.status(200));",
                    "pm.test(\"Pet ID and name are returned\", () => {",
                    "  pm.expect(pet.id).to.eql(Number(pm.collectionVariables.get(\"day08PetId\")));",
                    "  pm.expect(pet.name).to.eql(\"Day 08 Assessment Pet\");",
                    "});"
                  ]
                }
              }
            ]
          },
          {
            "id": "b48da0ba-5384-42d7-9303-eb2fa3bce4e4",
            "name": "CHAIN-02 - Get Pet By Saved ID",
            "request": {
              "url": {
                "path": [
                  "pet",
                  "{{day08PetId}}"
                ],
                "host": [
                  "{{baseUrl}}"
                ],
                "query": [],
                "variable": []
              },
              "method": "GET"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "aed902c5-33a4-428e-a3c5-6da8325b988e",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test(\"GET returns 200\", () => pm.response.to.have.status(200));",
                    "pm.test(\"GET retrieves same pet\", () => {",
                    "  const pet=pm.response.json();",
                    "  pm.expect(pet.id).to.eql(Number(pm.collectionVariables.get(\"day08PetId\")));",
                    "  pm.expect(pet.name).to.eql(\"Day 08 Assessment Pet\");",
                    "});"
                  ]
                }
              }
            ]
          },
          {
            "id": "5bca240f-b876-42df-a009-c5e6b02ff97b",
            "name": "CHAIN-03 - Delete Assessment Pet",
            "request": {
              "url": {
                "path": [
                  "pet",
                  "{{day08PetId}}"
                ],
                "host": [
                  "{{baseUrl}}"
                ],
                "query": [],
                "variable": []
              },
              "method": "DELETE"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "6d2208d6-ed55-49f1-8e83-9dff265fcbaa",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test(\"DELETE returns 200\", () => pm.response.to.have.status(200));"
                  ]
                }
              }
            ]
          }
        ],
        "event": []
      },
      {
        "id": "7562f9cf-27e3-483e-920b-3e4fb64c70c9",
        "name": "06 - JSON Schema Validation",
        "item": [
          {
            "id": "e4a6f9f4-e333-42a7-945f-cb8939780953",
            "name": "SCHEMA-01 - Validate Available Pet List",
            "request": {
              "url": {
                "path": [
                  "pet",
                  "findByStatus"
                ],
                "host": [
                  "{{baseUrl}}"
                ],
                "query": [
                  {
                    "key": "status",
                    "value": "available"
                  }
                ],
                "variable": []
              },
              "method": "GET"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "c455f6aa-8e7b-4b2c-be8a-cf69e485c629",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test(\"Response is 200\", () => pm.response.to.have.status(200));",
                    "const schema = {type:\"array\",items:{type:\"object\",properties:{",
                    "  id:{type:\"integer\"},name:{type:\"string\"},",
                    "  photoUrls:{type:\"array\",items:{type:\"string\"}},",
                    "  status:{type:\"string\"}",
                    "}}};",
                    "pm.test(\"Response matches JSON Schema\", () => pm.response.to.have.jsonSchema(schema));",
                    "pm.test(\"All returned pets are available\", () => {",
                    "  pm.response.json().forEach(pet => pm.expect(pet.status).to.eql(\"available\"));",
                    "});"
                  ]
                }
              }
            ]
          }
        ],
        "event": []
      },
      {
        "id": "a8306955-4541-46bc-a9fa-c08989d6382b",
        "name": "04 - Data Driven Tests",
        "item": [
          {
            "id": "80e1f0ef-643f-4952-972d-4f93a78c1de4",
            "name": "DDT-01 - Filter Pets by CSV Status",
            "request": {
              "url": {
                "path": [
                  "pet",
                  "findByStatus"
                ],
                "host": [
                  "{{baseUrl}}"
                ],
                "query": [
                  {
                    "key": "status",
                    "value": "{{status}}"
                  }
                ],
                "variable": []
              },
              "method": "GET"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "995aa646-b88f-4099-b0e5-c78d8eee9cca",
                  "type": "text/javascript",
                  "exec": [
                    "const status=pm.iterationData.get(\"status\") || pm.variables.get(\"status\");",
                    "const expectedCode=Number(pm.iterationData.get(\"expectedCode\") || pm.variables.get(\"expectedCode\"));",
                    "pm.test(\"Expected HTTP code\", () => pm.response.to.have.status(expectedCode));",
                    "pm.test(\"Response is an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));",
                    "pm.test(\"Pets match requested status\", () => {",
                    "  pm.response.json().forEach(pet => pm.expect(pet.status).to.eql(status));",
                    "});"
                  ]
                }
              }
            ]
          }
        ],
        "event": []
      },
      {
        "id": "02c503f5-3fbf-48b9-aa44-80bc02e37865",
        "name": "07 - Idempotency Testing",
        "item": [
          {
            "id": "afbdfe23-9b4c-4add-93c2-5d36918c66a1",
            "name": "IDEM-01 - Repeat Identical PUT (run twice)",
