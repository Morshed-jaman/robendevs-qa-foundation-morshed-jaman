              },
              "method": "GET"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "b9410370-70dd-444e-8a69-2f4216913bcf",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test(\"Final pet status is sold\", () => {",
                    "  pm.response.to.have.status(200);",
                    "  const pet=pm.response.json();",
                    "  pm.expect(pet.id).to.eql(Number(pm.collectionVariables.get(\"day08PetId\")));",
                    "  pm.expect(pet.status).to.eql(\"sold\");",
                    "});"
                  ]
                }
              }
            ]
          }
        ],
